# EXNIHILO — reverse proxy / static host.
#
# Install to /etc/caddy/Caddyfile. Caddy obtains and renews certificates
# automatically, so DNS for all three names must already point at this box.

# No global `email` directive: this repo is public, and an ACME contact address
# is a personal email. Caddy registers the ACME account without a contact, which
# only costs you Let's Encrypt expiry-warning mails — renewal itself is
# automatic. `email {$ACME_EMAIL}` is NOT a working substitute: with the var
# unset it expands to nothing and Caddy refuses the config with "wrong argument
# count or unexpected line ending after 'email'".
#
# To get the notices, add `email you@example.com` here on the server only.
# The live box already has a registered ACME account under /var/lib/caddy, so
# its existing certificates are unaffected either way.

exnihilo.markets {
	encode zstd gzip
	root * /srv/exnihilo/packages/site/dist

	# Every path react-router can actually render. Kept next to the router in
	# packages/site/src/main.tsx — if you add a top-level route there, add it
	# here too, or it will 404 on a hard refresh while working fine in-app.
	#
	# Split into two because they are served different files. index.html carries
	# the landing page prerendered to static HTML (scripts/prerender.mjs), which
	# is the right answer for "/" and the wrong one for every other route: a
	# crawler on /app/avalanche/markets would otherwise be handed the landing
	# page's content under that URL. app.html is the untouched shell.
	@shell path / /app /app/*
	@home path /
	@app path /app /app/*

	# Vite fingerprints everything under /assets, so it is safe to cache for a
	# year. The shell is handled separately below.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Self-hosted fonts are fingerprint-free but versioned by filename, and they
	# change only when the typeface does. A year is fine.
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	# The shell must not be cached — it is the file that names the current asset
	# hashes, so a stale copy pins the whole app to an old build. This matches on
	# the *request* path rather than /index.html: the SPA rewrite below happens
	# inside a `handle` block, which runs after `header`, so by the time the path
	# is /index.html this directive has already been evaluated and skipped.
	# `header /index.html ...` therefore only ever fired for a literal request to
	# /index.html, and the homepage shipped with no Cache-Control at all.
	header @shell Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin

		# One year, subdomains included. `indexer.exnihilo.markets` is covered by
		# includeSubDomains and is already HTTPS-only under Caddy, so this costs
		# it nothing — but note that it locks *every* future subdomain to HTTPS
		# for a year in any browser that has seen this header. That is the point,
		# and it is also why `preload` is deliberately absent: getting onto the
		# preload list is easy and getting off it takes months.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# The VitePress docs are real files under dist/docs. They must be matched
	# before the SPA fallback: otherwise a missing docs page silently renders
	# the trading app shell instead of a 404, which is how you end up shipping
	# a "working" docs link that shows the wrong site.
	@docs path /docs /docs/*
	handle @docs {
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	# The app shell, but only for paths the router knows. The previous rule here
	# was `try_files {path} /index.html`, which served the shell with 200 for
	# *any* URL: /sitemap.xml, /llms.txt and every typo returned a byte-identical
	# 783-byte page. That is a soft 404 — Google indexes an unbounded set of URLs
	# all carrying the same content, and genuinely broken links never surface in
	# Search Console because nothing ever reports failure.
	handle @home {
		rewrite * /index.html
		file_server
	}

	handle @app {
		rewrite * /app.html
		file_server
	}

	# Real files only: /assets/*, /fonts/*, favicon.svg, robots.txt, sitemap.xml,
	# og-image.png. A miss falls through to handle_errors below.
	handle {
		file_server
	}

	# `file_server` emits a 404 *error*, which by default renders Caddy's own
	# empty body. Route it to the branded page instead. The explicit `status 404`
	# matters: file_server would otherwise write 200 alongside the 404 body,
	# which is the same soft-404 bug wearing a different hat.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}

www.exnihilo.markets {
	redir https://exnihilo.markets{uri} permanent
}

# Ponder's Hono API. It already sends permissive CORS headers itself
# (`app.use("/*", cors())`), so do not add them here — duplicated
# Access-Control-Allow-Origin headers make browsers reject the response.
indexer.exnihilo.markets {
	encode zstd gzip
	reverse_proxy 127.0.0.1:42069
}
