# Private key of the deployer wallet (no 0x prefix)
ACCOUNT_PRIVATE_KEY=your_account_private_key_here

# Optional: override default public RPC endpoints
# AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ── Deployment parameters ─────────────────────────────────────────────────────

# Receives the protocol's fees (1% of every open's notional, 1% of profit on
# close). Local and testnet scripts fall back to the deployer when unset.
PROTOCOL_TREASURY=your_treasury_address_here

# deployMainnet.ts never falls back: it requires this explicitly.
MAINNET_PROTOCOL_TREASURY=
# Optional: defaults to native Avalanche USDC.
# MAINNET_USDC=

# No verification key is needed — see the Routescan note in hardhat.config.ts.
