# ── Which chain this instance follows ──────────────────────────────────────
# One Ponder process indexes exactly one chain. Defaults target Avalanche Fuji;
# override these together to point at a different deployment.
#
# Local Hardhat node — run `npx hardhat run scripts/deployLocal.ts --network localhost`
# first, then copy the addresses it writes to
# packages/site/src/contracts/localAddresses.json:
#   PONDER_CHAIN_ID=31337
#   PONDER_START_BLOCK=0
#   PONDER_FACTORY_ADDRESS=0x...
#   PONDER_POSITION_NFT_ADDRESS=0x...
#   PONDER_LP_NFT_ADDRESS=0x...

# ── RPC ─────────────────────────────────────────────────────────────────────
# The var name is suffixed with the chain id, so it must match PONDER_CHAIN_ID.
#
# Avalanche Fuji testnet RPC.
# The public endpoint works (getLogs is chunked to its 2048-block cap in
# ponder.config.ts) but backfill is slow — use Infura/Alchemy on the server.
PONDER_RPC_URL_43113=https://api.avax-test.network/ext/bc/C/rpc

# Local Hardhat node:
# PONDER_RPC_URL_31337=http://127.0.0.1:8545

# ── Storage ─────────────────────────────────────────────────────────────────
# Postgres connection (Neon, Supabase, or local Postgres on the VPS).
# Leave unset only for throwaway local runs.
# Local dev container (see deploy/README.md):
#   docker run -d --name exnihilo-pg -p 5432:5432 \
#     -e POSTGRES_USER=exnihilo -e POSTGRES_PASSWORD=exnihilo \
#     -e POSTGRES_DB=exnihilo_indexer -v exnihilo-pgdata:/var/lib/postgresql/data \
#     --restart unless-stopped postgres:16-alpine
#
# Required in production — PGlite (the fallback when unset) is single-process
# and cannot survive a rolling restart. See deploy/README.md.
DATABASE_URL=postgresql://exnihilo:exnihilo@127.0.0.1:5432/exnihilo_indexer

# HTTP port for the indexer API (default 42069)
# PORT=42069
