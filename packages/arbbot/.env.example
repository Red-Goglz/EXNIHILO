# ── Chain / RPC ─────────────────────────────────────────────────────────────
# Defaults target the Avalanche C-Chain mainnet deployment (43114).
# The public endpoint works but is rate limited; use a paid provider for a
# tight POLL_INTERVAL_MS.
RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Factory whose registry is scanned. Defaults to the mainnet factory in
# packages/site/src/contracts/addresses.ts.
# FACTORY_ADDRESS=0xBe6Fb0e7b7d8EFD491FEbC436F737cE8B244F85a
# USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E

# ── Scanning ────────────────────────────────────────────────────────────────
# Seconds between full scans. Pool discovery is re-run every cycle; static
# per-pool data (token, decimals, swap fee) is cached for the process lifetime.
POLL_INTERVAL_MS=30000

# Cheap pre-filter. A pool is only sent to the (slow, rate-limited) size-ladder
# stage if its mid-price gap to the DEX exceeds the pool swap fee + this margin.
# This is a rough gate to skip obviously dead pools, not the profit decision.
MIN_EDGE_BPS=25

# An opportunity is only printed if the simulated round trip nets at least this
# much USDC after both legs' fees, slippage haircut, and gas. The default is
# deliberately low — live pools are seeded with tens of dollars, so a genuine
# edge nets cents. Raise it once pools carry real depth.
MIN_PROFIT_USDC=0.1

# Trade sizes (whole USDC) probed against each candidate pool. Sizes above
# MAX_POOL_DEPTH_BPS of the pool's USDC reserve are dropped automatically.
SIZE_LADDER_USDC=25,50,100,250,500,1000,2500,5000,10000

# Never probe a size larger than this share of the pool's backedAirUsd reserve —
# beyond it, EXNIHILO price impact swamps any edge.
MAX_POOL_DEPTH_BPS=3000

# Extra ternary-search steps to refine the best ladder rung (0 disables).
# Each step costs one aggregator quote.
REFINE_STEPS=4

# ── Execution assumptions (used for costing, nothing is ever sent) ──────────
# Haircut applied to every aggregator quote to approximate real fill slippage.
SLIPPAGE_BPS=50

# Gas units for a full two-leg arb (EXNIHILO swap + aggregator route).
GAS_UNITS=700000

# ── DEX quote source ────────────────────────────────────────────────────────
# Comma-separated, tried in order until one answers. All three are keyless.
#   kyberswap | openocean | lifi
QUOTE_PROVIDERS=kyberswap,openocean,lifi

# Max concurrent aggregator requests, and pause between them per worker.
QUOTE_CONCURRENCY=3
QUOTE_DELAY_MS=120

# Optional: KyberSwap attributes volume to this id. Cosmetic only.
# KYBERSWAP_CLIENT_ID=exnihilo-arbbot

# Minutes to remember that a token has no routable DEX market before re-probing.
NO_ROUTE_TTL_MIN=60

# ── Output ──────────────────────────────────────────────────────────────────
# Print a line for every pool scanned, not just the profitable ones.
VERBOSE=false
