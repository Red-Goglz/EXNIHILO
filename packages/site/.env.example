# WalletConnect project id — https://cloud.walletconnect.com
VITE_WC_PROJECT_ID=your_project_id_here

# Formo analytics write key. Client-side by design — it ships in the bundle, so
# it is not a secret — but Formo ORIGIN-LOCKS it: a key issued for one domain is
# rejected on another, and the failure is silent because every call site uses
# `analytics?.track(...)`. Issue a key for the domain you actually deploy to.
# Leave unset to disable analytics entirely (local dev, CI, previews).
VITE_FORMO_WRITE_KEY=

# Indexer for Avalanche mainnet — one Ponder instance per chain. Unset, the
# indexer-backed views (charts, APR, analytics) show an "unavailable" state.
VITE_INDEXER_URL_AVALANCHE=https://indexer.exnihilo.markets

# Avalanche RPC for public reads (defaults to the official endpoint).
# VITE_RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
