# Get a free project ID at https://cloud.walletconnect.com
VITE_WC_PROJECT_ID=your_project_id_here

# Formo analytics write key. Client-side by design — it ships in the bundle, so
# it is not a secret — but Formo ORIGIN-LOCKS it: a key issued for one domain is
# rejected on another, and the failure is silent because every call site uses
# `analytics?.track(...)`. Issue a key for the domain you actually deploy to.
# Leave unset to disable analytics entirely (local dev, CI, previews).
VITE_FORMO_WRITE_KEY=

# Indexer URLs — one Ponder instance per chain, each rejecting other chains.
# A chain with no URL here is simply never queried; the UI shows an
# "unavailable" state instead of firing requests that can only 404.
#
# Avalanche Fuji:
VITE_INDEXER_URL_FUJI=https://indexer.exnihilo.markets

# Local Hardhat node (see packages/indexer — `npm run dev:indexer`):
# VITE_INDEXER_URL_LOCAL=http://localhost:42069

# Avalanche Fuji RPC URL for public reads (defaults to the official endpoint).
# Alternatives: https://avalanche-fuji-c-chain-rpc.publicnode.com, https://rpc.ankr.com/avalanche_fuji
VITE_RPC_FUJI=https://api.avax-test.network/ext/bc/C/rpc
